# 复制为 .env（本地）或 .env.production（部署）。密钥不入库。
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Redis（生产 compose 内为 redis://redis:16000；旧宿主映射为 27125 端口）
REDIS_URL=redis://127.0.0.1:16000

# MinIO / S3（预签名直传，浏览器需能访问该 Host）
MINIO_ENDPOINT=minio.8and1.cn
MINIO_PORT=80
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=<轮换后的新密钥>
MINIO_SECRET_KEY=<轮换后的新密钥>
MINIO_BUCKET=send
MINIO_REGION=us-east-1
# 预签名 URL 协议策略：auto | keep | https
MINIO_URL_SCHEME=auto

# 房间/上传
ROOM_TTL=2592000            # 30 天（与线上现值一致）
ROOM_MAX_MESSAGES=1000
UPLOAD_SIGN_TTL=604800      # 7 天
MAX_UPLOAD_SIZE=2147483648

# Socket.IO
SOCKET_PING_INTERVAL=3500

# 清扫定时器（秒）
CLEANUP_INTERVAL=600
