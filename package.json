{
  "name": "ff-send",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && tsc -p tsconfig.server.json",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "openapi": "tsx scripts/export-openapi.ts",
    "codegen": "npm run openapi && orval --config scripts/orval.config.ts",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.5",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "^3.12.4",
    "@mcansh/react-router-fastify": "6.0.2",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@react-router/node": "8.5.2",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.469.0",
    "minio": "^8.0.4",
    "openapi-types": "12.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.0.0",
    "react-router": "8.5.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^7.0.3",
    "orval": "8.48.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
